{% extends 'layouts/page.njk' %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block pageTitle %}{% if errorList.length %}Error: {% endif %}{{ t('tasks.list.page_title') }} - {{ serviceName }}{% endblock %}

{% block content %}
  {% include "partials/error-summary.njk" %}

  {% if notice %}
    {{ govukNotificationBanner({ type: "success", text: notice }) }}
  {% endif %}

  <h1 class="govuk-heading-xl">{{ t('tasks.list.heading') }}</h1>

  {{ govukButton({ text: t('tasks.list.create_button'), href: "/tasks/new" }) }}

  <form action="{{ baseUrl }}" method="get" role="search" aria-label="{{ t('tasks.list.search.aria_label') }}" data-testid="tasks-search-form">
    {{ govukInput({
      label: { text: t('tasks.list.search.label') },
      hint: { text: t('tasks.list.search.hint') },
      id: "search",
      name: "search",
      value: filters.search,
      classes: "govuk-!-width-one-half",
      errorMessage: searchError
    }) }}

    <div class="govuk-button-group">
      {{ govukButton({ text: t('tasks.list.search.button'), type: "submit", classes: "govuk-button--secondary" }) }}
      {% if filters.search %}
        <a href="{{ baseUrl }}" class="govuk-link" data-testid="clear-search">{{ t('tasks.list.search.clear') }}</a>
      {% endif %}
    </div>
  </form>

  {% if tasks.length %}
    {% if filters.search %}
      <p class="govuk-body" data-testid="results-summary">
        {{ tasks.length }} {{ t('tasks.list.summary.matching') }} <strong>{{ filters.search }}</strong>
      </p>
    {% endif %}

    <table class="govuk-table">
      <caption class="govuk-table__caption govuk-visually-hidden">{{ t('tasks.list.caption') }}</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">{{ t('tasks.list.title') }}</th>
          <th scope="col" class="govuk-table__header">{{ t('tasks.list.due') }}</th>
          <th scope="col" class="govuk-table__header">{{ t('tasks.list.status') }}</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for task in tasks %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <a class="govuk-link" href="/tasks/{{ task.id }}">{{ task.title }}</a>
            </td>
            <td class="govuk-table__cell">
              {{ task.dueDateTime | formatDateTime }}
              {% if task.overdue %}<strong class="govuk-tag govuk-tag--red">{{ t('common.overdue') }}</strong>{% endif %}
            </td>
            <td class="govuk-table__cell">
              {{ govukTag({ text: t('tasks.status.' + task.status), classes: TASK_STATUS_TAG_CLASS[task.status] }) }}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% elif not errorList.length or searchError %}
    <p class="govuk-body" data-testid="no-results">
      {% if filters.search %}{{ t('tasks.list.no_matches') }} <strong>{{ filters.search }}</strong>{% else %}{{ t('tasks.list.empty') }}{% endif %}
    </p>
  {% endif %}
{% endblock %}
