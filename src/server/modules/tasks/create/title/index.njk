{% extends 'layouts/page.njk' %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}{% if errorList.length %}Error: {% endif %}{{ t('tasks.create.title.page_title') }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({ text: t('common.back'), href: backLink }) }}
{% endblock %}

{% block content %}
  {% include "partials/error-summary.njk" %}

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}">

    {{ govukInput({
      id: "title",
      name: "title",
      label: {
        text: t('tasks.create.title.heading'),
        classes: "govuk-label--xl",
        isPageHeading: true
      },
      hint: { text: t('tasks.create.title.hint') },
      classes: "govuk-!-width-one-half",
      value: formData.title,
      errorMessage: fieldErrors.title
    }) }}

    {{ govukButton({ text: t('tasks.create.continue') }) }}
  </form>
{% endblock %}
