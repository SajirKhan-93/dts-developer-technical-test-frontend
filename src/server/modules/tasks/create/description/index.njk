{% extends 'layouts/page.njk' %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}{% if errorList.length %}Error: {% endif %}{{ t('tasks.create.description.page_title') }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({ text: t('common.back'), href: backLink }) }}
{% endblock %}

{% block content %}
  {% include "partials/error-summary.njk" %}

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}">

    {{ govukTextarea({
      id: "description",
      name: "description",
      label: {
        text: t('tasks.create.description.heading'),
        classes: "govuk-label--xl",
        isPageHeading: true
      },
      hint: { text: t('tasks.create.description.hint') },
      rows: 6,
      value: formData.description,
      errorMessage: fieldErrors.description
    }) }}

    {{ govukButton({ text: t('tasks.create.continue') }) }}
  </form>
{% endblock %}
