{% extends 'layouts/page.njk' %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}{% if errorList.length %}Error: {% endif %}{{ t('tasks.create.status.page_title') }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({ text: t('common.back'), href: backLink }) }}
{% endblock %}

{% block content %}
  {% include "partials/error-summary.njk" %}

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}">

    {{ govukRadios({
      name: "status",
      idPrefix: "status",
      fieldset: {
        legend: {
          text: t('tasks.create.status.heading'),
          isPageHeading: true,
          classes: "govuk-fieldset__legend--xl"
        }
      },
      items: statusItems,
      errorMessage: fieldErrors.status
    }) }}

    {{ govukButton({ text: t('tasks.create.continue') }) }}
  </form>
{% endblock %}
